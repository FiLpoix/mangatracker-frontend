{
  "expo": {
    "name": "mangaTracker",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/HatsuneMiku.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/HatsuneMiku.png",
        "backgroundColor": "#0d0d0e"
      },
      "package": "com.lfilpo.mobile"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "b1279199-79f2-46da-bba8-136af046c013"
      }
    },
    "plugins": [
      "expo-status-bar"
    ]
  }
}
